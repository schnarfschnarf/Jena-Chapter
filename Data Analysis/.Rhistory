library(ragg)
library(here)
knitr::opts_chunk$set(
warning = FALSE, message = FALSE, echo = TRUE,
cache = TRUE, cache.lazy = FALSE,
cache.path = "cache/",
out.width = "100%", out.height = "100%",
dev = "ragg_png"
)
# Make sure cache/figures/output exist (prevents silent failures on new machines)
dir.create(here("cache"), showWarnings = FALSE, recursive = TRUE)
dir.create(here("figures"), showWarnings = FALSE, recursive = TRUE)
# Source project functions from the repo (portable)
source(here("functions", "myfunctions.R"))
source(here("functions", "fit_or_load.R"))
stopifnot(exists("theme_custom"))
# Define a portable output directory for ggsave()
out_dir <- here("3_Graphs")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
# load synthesis dataset
ecologicalMF <- read_xlsx(
here("1_Data", "ecological_multifunctionality_reduced.xlsx")
) %>%
filter(!is.na(sowndiv) & sowndiv < 60)
economicMF <- read_xlsx(
here("1_Data", "economic_MF_final.xlsx")
) %>%
filter(sowndiv < 60)
ecologicalMF$plotcode <- as.factor(ecologicalMF$plotcode)
ecologicalMF$block <- as.factor(ecologicalMF$block)
economicMF$plotcode <- as.factor(economicMF$plotcode)
fitMFsown <- fit_or_load("fitMFsown", function() {
brm(
multifunctionality ~ log2(sowndiv) + (1|block),
control = list(adapt_delta = 0.95),
iter = 3000,
ecologicalMF)
})
# check model output
summary(fitMFsown)
#plot multifunctionality as a response to sowndiv
c_sown_mf <- conditional_effects(fitMFsown)
plot_sown_mf_data <- c_sown_mf[[1]]
p_sown_mf <- ggplot() +
# raw data
geom_point(
data   = ecologicalMF,
aes(x  = sowndiv, y = multifunctionality),
alpha  = 0.5,
size   = 2,
shape  = 21,
fill   = "#0072B2",
colour = "#004C70",
stroke = 0.4,
position = position_jitter(width = 0.12, height = 0)
) +
# model-estimated effect
geom_line(
data     = plot_sown_mf_data,
aes(x    = sowndiv, y = estimate__),
colour   = "#0072B2",
linewidth = 0.8
) +
# credible interval ribbon
geom_ribbon(
data  = plot_sown_mf_data,
aes(x = sowndiv, ymin = lower__, ymax = upper__),
fill  = "#0072B2",
alpha = 0.15
) +
# axis scaling
scale_x_continuous(
breaks = c(1, 2, 4, 8, 16),
labels = c(1, 2, 4, 8, 16),
expand = expansion(mult = c(0.02, 0.02))
) +
labs(
x = "Sown plant species diversity",
y = "Ecological multifunctionality"
) +
theme_custom()
p_sown_mf
# merge reduced ecological and economic multifunctionality data
joinedMF <- economicMF %>%
select(c(plotcode, costs_total_mid)) %>%
left_join(ecologicalMF, by = "plotcode")
# Correlation between economic and ecological multifunctionality
bf <- BayesFactor::correlationBF(joinedMF$multifunctionality, joinedMF$costs_total_mid)
post <- BayesFactor::posterior(bf, iterations = 20000)
rho_draws <- post[, "rho"]
quantile(rho_draws, c(.025, .5, .975))
mean(rho_draws)
# plot the correlation
corrPlot <- ggplot(joinedMF, aes(x = multifunctionality, y = costs_total_mid)) +
# raw data
geom_point(
alpha  = 0.5,
size   = 2.2,
shape  = 21,
fill   = "#0072B2",
colour = "#004C70",
stroke = 0.4
) +
# linear regression line
geom_smooth(
method = "lm",
se     = FALSE,
linewidth = 0.8,
colour = "#0072B2"
) +
scale_x_continuous(
breaks = seq(0.1, 0.7, by = 0.1),
expand = expansion(mult = c(0.02, 0.02))
) +
scale_y_continuous(
breaks = c(-1000, -500, 0, 500, 1000)
) +
labs(
x = "Ecological multifunctionality",
y = expression(
"Economic multifunctionality (" * "\u20AC ha"^{-1} ~ "yr"^{-1} * ")")
) +
theme_custom()
corrPlot
# save figure
ggsave(
filename = "Corr_EconomicMF_EcologicalMF.png",
plot     = corrPlot,
device   = "png",
path = out_dir,
dpi      = 300,
width    = 6.27,
height   = 5,
units    = "in"
)
# create two panel plot with economic MF
fig_MF_and_corr <- (
p_sown_total /
plot_spacer() /
corrPlot
) +
plot_layout(heights = c(1, 0.09, 1)) +
plot_annotation(tag_levels = "a") &
theme(
plot.tag.position = c(0.08, 0.98),
plot.tag = element_text(face = "bold", hjust = 0, vjust = 1),
axis.title.y = element_text(margin = margin(r = 2)),
plot.margin = margin(10, 15, 10, 15)
)
fig_MF_and_corr
ggsave(
filename = "Fig_MF_and_corr.png",
plot     = fig_MF_and_corr,
width    = 5.9,
height   = 6.6,
units    = "in",
dpi      = 300,
device   = ragg::agg_png,
path = out_dir
)
